# Global clang-format style. clang-format walks up parent directories looking
# for a .clang-format, so this is the default for every C/C++ file under ~,
# while any project that ships its own .clang-format still wins.
#
# Matches the C/C++ editor settings from the old config: 4-space indent, no tabs.
---
BasedOnStyle: LLVM
IndentWidth: 4
TabWidth: 4
UseTab: Never
ColumnLimit: 100

# clang-format's Standard enum stops at c++20; "Latest" is how you ask for
# newer. A literal "c++23" is rejected as an unknown value.
Standard: Latest

AllowShortFunctionsOnASingleLine: Empty
AllowShortIfStatementsOnASingleLine: false
AllowShortLoopsOnASingleLine: false
BreakBeforeBraces: Attach
PointerAlignment: Left
SortIncludes: CaseSensitive
SpaceAfterTemplateKeyword: false

# LLVM's default (MultiLine) merges `template <...>` onto the declaration line
# whenever the whole thing fits in ColumnLimit. Always break instead.
# (Renamed to BreakTemplateDeclarations in clang-format 19; this spelling works
# on Apple clang-format 17 and is still accepted by newer versions.)
AlwaysBreakTemplateDeclarations: Yes
