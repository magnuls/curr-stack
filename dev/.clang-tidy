# clang-tidy checks, run by clangd (--clang-tidy in lua/configs/lspconfig.lua).
#
# Lives at $HOME for the same reason ~/.clang-format does: clang-tidy walks up
# parent directories, so this is the default for everything under ~, and any
# project with its own .clang-tidy overrides it wholesale.
#
# Deliberately narrow. readability-* and cppcoreguidelines-* are where the noise
# lives -- they fire constantly on correct code and are the reason people turn
# --clang-tidy back off. What is left catches real bugs the compiler misses.
Checks: >
  bugprone-*,
  performance-move-const-arg,
  performance-unnecessary-value-param,
  modernize-use-override,
  modernize-use-nullptr,
  -bugprone-easily-swappable-parameters,
  -bugprone-narrowing-conversions

# Diagnostics on the .cpp only. Empty = no headers, which keeps a noisy
# third-party header from reporting through every file that includes it.
HeaderFilterRegex: ''

# Nothing here is fatal in the editor; clangd shows these as warnings.
WarningsAsErrors: ''
